# Polar AI Commerce — environment variables
# Copy to .env for local development. NEVER commit real values (see docs/security/security-architecture.md).
# Production values live in the deployment platform's secrets manager, not in a file.

# --- App ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# --- Database ---
DATABASE_URL=postgres://polar:polar@localhost:5432/polar_ai_commerce

# --- Redis / Queue ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
SESSION_SECRET=
JWT_SIGNING_KEY=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Meta WhatsApp Business Platform (Cloud API) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- VTEX ---
VTEX_ACCOUNT_NAME=
VTEX_ENVIRONMENT=
VTEX_APP_KEY=
VTEX_APP_TOKEN=

# --- Object storage (S3-compatible) ---
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
